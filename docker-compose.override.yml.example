# Only needed when cdn.playwright.dev is blocked from this host (Dockerfile
# and docs/deployment.md have the detail) and you've set
# SKIP_CHROMIUM_DOWNLOAD=true in .env plus run scripts/download-chromium.ps1
# on an unrestricted machine.
#
# Copy this file to docker-compose.override.yml (that filename is loaded
# automatically by `docker compose`, no extra -f flag needed) and it adds
# this one bind mount on top of docker-compose.yml. Left as a separate,
# opt-in file rather than a line in docker-compose.yml itself because an
# unconditional mount here would shadow the image's own baked-in browser
# for everyone who never hit the block in the first place.

services:
  gpu-worker:
    volumes:
      - ${PW_BROWSERS_DIR:-./pw-browsers}:/opt/pw-browsers:ro
