# The GPU host itself (handoff section 12: one RTX 3090 Ti, 64GB+ RAM,
# NVMe) — phase 0 model validation, and production-with-GPU once phase 0
# signs off (docs/phase-0-checklist.md).
#
# Model weights are never downloaded by this app, its Docker image, or
# docker-compose.yml. Run scripts/download-models.ps1 on a separate machine
# with internet access, copy the resulting folder onto this host, and point
# MODELS_DIR at it. `python scripts/check_models.py` — also run
# automatically before gpu-worker starts (docker-compose.yml) — reports
# what is actually present; it never fetches anything itself.
#
# This is a DELTA file: only what differs from the defaults in .env.example
# is listed below. Every other setting keeps its .env.example default —
# see that file for the full, documented list. Copy the values you need
# from here into your real .env; do not `cp` this file directly.

ENVIRONMENT=production
MODELS_DIR=/srv/models

# vLLM is real (app/agents/llm.py's VllmClient) and independent of
# GPU_RUNTIME below — point it at wherever vLLM is actually served. vLLM
# itself is a separate process/container this repository's compose file
# does not run; it reads its own model weights directly, not through
# MODELS_DIR or this container.
LLM_CLIENT=vllm
LLM_BASE_URL=http://localhost:8001
LLM_MODEL=Qwen/Qwen3-30B-A3B

# Image (FLUX via ComfyUI), video (Wan 2.2), whisper transcription and
# lip-sync all go through GPU_RUNTIME, which has no real implementation yet
# — app/worker/gpu_runtime.py's UnavailableGpuRuntime fails loudly rather
# than pretending, and phase 0 is what replaces it. Leave this as
# "simulated" until that lands; MODELS_DIR above is still worth filling in
# now so `check_models.py` can confirm the weights are ready the moment the
# real runtime does.
GPU_RUNTIME=simulated

# Piper (fa) / Chatterbox (en/ar) are the documented real targets
# (app/services/tts_backend.py) but are not wired up yet either — same
# "fails loudly, not simulated by accident" reasoning. TTS_BACKEND=espeak
# (real, offline, no model needed) stays the default until they are.
TTS_BACKEND=espeak
IMAGE_BACKEND=simulated

STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_SECURE=false

RATE_LIMIT_BACKEND=redis
