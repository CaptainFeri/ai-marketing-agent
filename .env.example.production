# Production.
#
# app/core/config.py's Settings refuses to start with ENVIRONMENT=production
# unless SECRET_KEY and CREDENTIAL_ENCRYPTION_KEY are both real (not the
# dev placeholder / empty) and DEBUG is off — that check is not decorative,
# it is what stops this file's placeholders from ever running for real.
#
# This is a DELTA file: only what differs from the defaults in .env.example
# is listed below. Every other setting keeps its .env.example default —
# see that file for the full, documented list. Copy the values you need
# from here into your real .env; do not `cp` this file directly.

ENVIRONMENT=production
DEBUG=false

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_KEY_VERSION=1

DATABASE_URL=postgresql+psycopg://app:REPLACE@postgres:5432/ai_marketing
SYSTEM_DATABASE_URL=postgresql+psycopg://app_system:REPLACE@postgres:5432/ai_marketing
REDIS_URL=redis://redis:6379/0

STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://REPLACE-with-a-publicly-reachable-endpoint
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=ai-marketing
S3_SECURE=true

RATE_LIMIT_BACKEND=redis

# --- The GPU-backed pieces (LLM, image, video, TTS, whisper, lip-sync) ---
# Phase 0 (docs/phase-0-checklist.md) has to run and sign off on the real
# GPU host before these switch away from the same safe defaults local dev
# uses. Setting any of them to something else today fails loudly
# (app/worker/gpu_runtime.py's UnavailableGpuRuntime,
# app/services/tts_backend.py's _UnavailableTtsBackend) rather than quietly
# serving placeholder content to a real customer — that is intentional.
# Once phase 0 signs off, copy the real values from .env.example.gpu-host.
GPU_RUNTIME=simulated
LLM_CLIENT=simulated
IMAGE_BACKEND=simulated
TTS_BACKEND=espeak

# Observability and backups matter most exactly where this file is used.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
BACKUP_DIR=/var/backups/ai-marketing
BACKUP_RETENTION_DAYS=30
