# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
ENVIRONMENT=local            # local | staging | production | test
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# DATABASE_URL is the tenant-scoped connection. Its role must NOT have
# BYPASSRLS — row level security is what keeps customers apart (decision D8).
DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/ai_marketing
# SYSTEM_DATABASE_URL is used only by the GPU scheduler, the quota allocator
# and Alembic. Its role owns the tables and holds BYPASSRLS.
SYSTEM_DATABASE_URL=postgresql+psycopg://app_system:app_system@postgres:5432/ai_marketing
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Set to 1 only where pgvector is unavailable; retrieval features are skipped.
# ALLOW_MISSING_PGVECTOR=0

# ---------------------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Secrets — replace every value below before staging or production
# ---------------------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=insecure-development-secret-key-do-not-use-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Channel tokens are encrypted with this key before they touch the database.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_KEY_VERSION=1

# ---------------------------------------------------------------------------
# Object storage (MinIO) — one prefix per tenant
# ---------------------------------------------------------------------------
# "memory" keeps every object in a process-local dict — no MinIO needed yet,
# same idea as GPU_RUNTIME=simulated. Switch to "s3" once MinIO is up.
STORAGE_BACKEND=memory
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ai-marketing
S3_SECURE=false

# ---------------------------------------------------------------------------
# GPU capacity (handoff sections 6 and 7)
#
# Do not hand-tune these. Run:
#     .venv/bin/python scripts/analyze_platform.py --benchmark
# It probes the machine and prints the values that follow from it, together
# with what it inferred and why. The defaults below assume the design target:
# one RTX 3090 Ti, 64 GB RAM, NVMe.
# ---------------------------------------------------------------------------
# Seconds of GPU time handed out per day. 20h leaves head-room for model
# swaps and maintenance on a 24h day.
GPU_DAILY_CAPACITY_SECONDS=72000
GPU_MAX_BATCH_SECONDS=900
GPU_MAX_BATCH_SIZE=8
GPU_WINDOW_STARVATION_SECONDS=1800
# Replace with the number phase 0 measures for a vLLM sleep/wake cycle.
GPU_WINDOW_SWITCH_SECONDS=45
GPU_NIGHT_WINDOW_START_HOUR=1
GPU_NIGHT_WINDOW_END_HOUR=7
GPU_LEASE_TIMEOUT_SECONDS=3600
# Turn off on a card with under 20 GB VRAM: Wan 2.2 cannot run, so nothing
# should queue work that will only ever wait.
GPU_NIGHTLY_VIDEO_ENABLED=true

# simulated = run the platform with no model weights present (phase 0/1).
# Anything else expects a real runtime, which phase 0 delivers.
GPU_RUNTIME=simulated
GPU_SIMULATION_SPEEDUP=600

# ---------------------------------------------------------------------------
# Language model (decision D1 — self-hosted, nothing leaves this server)
# ---------------------------------------------------------------------------
# "simulated" runs the whole pipeline with contract-valid output and no
# weights. "vllm" talks to a local vLLM server.
LLM_CLIENT=simulated
LLM_BASE_URL=http://localhost:8001
LLM_MODEL=Qwen/Qwen3-30B-A3B
LLM_TIMEOUT_SECONDS=600
# How vLLM is told to constrain generation to the schema. Recent builds take
# "response_format"; older ones want "guided_json". The wrong value means
# generation is not constrained at all, and that failure shows up much later.
LLM_GUIDED_MODE=response_format
# Tries an agent gets before its step fails. Each retry carries the validation
# errors back into the prompt.
AGENT_MAX_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Image generation (handoff section 5)
# ---------------------------------------------------------------------------
# "simulated" produces a deterministic placeholder in place of FLUX.1-schnell;
# phase 0 delivers the ComfyUI workflow this switches to.
IMAGE_BACKEND=simulated
# Left unset in production: the Docker image runs `playwright install
# chromium` at build time and the bundled browser resolves on its own. Set
# only to point at a browser in a nonstandard location.
# PLAYWRIGHT_EXECUTABLE_PATH=
OVERLAY_RENDER_TIMEOUT_SECONDS=15

# ---------------------------------------------------------------------------
# Publishing (handoff section 10) — no settings needed here.
#
# Channel credentials (a WordPress Application Password, a Telegram bot
# token) are stored per workspace via the API, encrypted with
# CREDENTIAL_ENCRYPTION_KEY above — never in this file.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Pipeline
# ---------------------------------------------------------------------------
QA_MAX_RETRIES=2
SUPPORTED_LOCALES=fa,en,ar
DEFAULT_LOCALE=fa
# Worker processes on the CPU queues. The GPU queue is always 1 — see D9.
CELERY_CPU_CONCURRENCY=4

# ---------------------------------------------------------------------------
# Observability (docker-compose.langfuse.yml — see docs/observability.md)
# ---------------------------------------------------------------------------
# LANGFUSE_HOST=http://langfuse-web:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-00000000-0000-0000-0000-000000000000
# LANGFUSE_SECRET_KEY=sk-lf-00000000-0000-0000-0000-000000000000

# ---------------------------------------------------------------------------
# Backups (handoff section 7, week 9 — see docs/observability.md)
# ---------------------------------------------------------------------------
# BACKUP_DIR=./backups
# BACKUP_RETENTION_DAYS=14
# PG_DUMP_BINARY=pg_dump

# ---------------------------------------------------------------------------
# Rate limiting (self-service signup — see docs/self-service-signup.md)
# ---------------------------------------------------------------------------
# RATE_LIMIT_BACKEND=redis
# REGISTRATION_RATE_LIMIT_PER_HOUR=5
# REGISTRATION_RATE_LIMIT_PER_EMAIL_PER_HOUR=3

# ---------------------------------------------------------------------------
# Model weights — never downloaded by this app or docker-compose.yml.
# Run scripts/download-models.ps1 on a machine with internet access, copy
# its output here, then `python scripts/check_models.py` (also run
# automatically before gpu-worker starts) reports what is actually present.
# ---------------------------------------------------------------------------
# MODELS_DIR=./models
