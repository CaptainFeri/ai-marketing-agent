# Staging: a shared server with real Postgres/Redis/MinIO, no GPU.
#
# This exercises the full multi-tenant product surface — auth, RLS,
# pipeline orchestration, gates, publishing, the panel — against
# contract-valid simulated text/image/audio, the same as local dev; it does
# not test model quality (that is phase 0, on the real GPU host).
#
# This is a DELTA file: only what differs from the defaults in .env.example
# is listed below. Every other setting keeps its .env.example default —
# see that file for the full, documented list. Copy the values you need
# from here into your real .env; do not `cp` this file directly, since the
# secrets below are placeholders.

ENVIRONMENT=staging
DEBUG=false

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

DATABASE_URL=postgresql+psycopg://app:REPLACE@staging-postgres:5432/ai_marketing
SYSTEM_DATABASE_URL=postgresql+psycopg://app_system:REPLACE@staging-postgres:5432/ai_marketing
REDIS_URL=redis://staging-redis:6379/0

STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://staging-minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SECURE=false

# No GPU on staging — the pipeline runs end to end against contract-valid
# output, same as local dev. Real values live in .env.example.gpu-host.
GPU_RUNTIME=simulated
LLM_CLIENT=simulated
IMAGE_BACKEND=simulated
TTS_BACKEND=espeak

# Real, since staging is a shared multi-process-capable server, not a
# single local dev process.
RATE_LIMIT_BACKEND=redis

# Optional: point at a staging Langfuse project if you run one.
# LANGFUSE_HOST=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
